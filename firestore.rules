rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funciones de Ayuda ---
    function isAdmin() {
      // Verifica si el token de autenticación del usuario tiene el claim 'admin' como true.
      return request.auth.token.admin == true;
    }

    function isOwner(userId) {
      // Verifica si el usuario que hace la petición es el dueño del documento.
      return request.auth.uid == userId;
    }

    function isResidentOfProperty(propertyId) {
      // Verifica si el ID de la propiedad está presente en el array de propiedades del usuario.
      return propertyId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.propertyIds;
    }

    // --- Reglas para Colecciones ---

    // Perfiles de Usuario
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow create: if request.auth != null;
    }

    // Propiedades
    match /properties/{propertyId} {
      allow write: if isAdmin();
      allow get, list: if request.auth != null;
    }

    // Solicitudes de Vinculación Residencial
    match /membershipRequests/{requestId} {
      // Permitimos crear, leer y listar a cualquier usuario autenticado.
      allow create, read, list: if request.auth != null;
      // El usuario puede modificar sus propias solicitudes (ej: descartar visibleToUser).
      // El admin puede gestionar (aprobar/rechazar/borrar).
      allow update: if isAdmin() || request.auth.uid == resource.data.userId;
      allow delete: if isAdmin();
    }

    // Transacciones (Historial Financiero)
    match /transactions/{transactionId} {
      // Admin: lectura y escritura total del historial.
      allow read, write: if isAdmin();
      // Residente: solo lectura de las transacciones de sus propias unidades (propertyIds).
      allow get, list: if isResidentOfProperty(resource.data.propertyId);
      // Gastos de la administración (tipo EXPENSE): visibles para cualquier usuario autenticado.
      allow get, list: if request.auth != null && resource.data.type == 'EXPENSE';
    }

    // Conceptos de Cargo (Catálogo de Servicios)
    match /chargeConcepts/{conceptId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Cuentas de Gasto (Catálogo de Gastos Generales)
    match /expenseAccounts/{accountId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Solicitudes de Servicio
    match /serviceRequests/{requestId} {
      allow create, read, list: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Eventos del Calendario Comunitario
    match /communityEvents/{eventId} {
      // Cualquier usuario autenticado puede leer (los residentes consultan el
      // calendario comunitario). La gestión (crear/editar/borrar) es solo del
      // administrador; antes cualquier autenticado podía crear eventos.
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Notificaciones de Pago
    match /paymentNotifications/{notificationId} {
      // El residente solo puede crear SU reporte, siempre en estado pendiente y
      // con un monto válido. El estado, el recibo y la revisión los escribe el
      // admin en la aprobación: por eso `update` queda restringido a admin.
      allow create: if request.auth != null
        && request.resource.data.residentUid == request.auth.uid
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      // Antes cualquier autenticado podía listar TODOS los reportes (nombre,
      // monto, comprobante, motivo de rechazo) de las demás unidades.
      allow get, list: if isAdmin() || resource.data.residentUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Colección de Actividades: Log inmutable de eventos.
    match /activities/{activityId} {
      // Crear: cualquier autenticado, pero la actividad debe declarar quién
      // puede verla (`visibility` es el filtro de las consultas del cliente).
      allow create: if request.auth != null
        && request.resource.data.visibility is list
        && request.resource.data.visibility.size() > 0;
      // Leer: el admin ve todo; el residente solo lo que lo incluye
      // explícitamente en `visibility` (antes podía leer todo el log).
      // Las actividades antiguas sin `visibility` dejan de ser legibles por
      // residentes; el admin sigue viéndolas.
      allow get, list: if isAdmin()
        || request.auth.uid in resource.data.get('visibility', []);
      allow update, delete: if false; // Nadie puede modificar o borrar lo ya registrado.
    }

    // Contadores de Voucher (system/counters)
    // Usados por _generateVoucher/_generateBatchVouchers (runTransaction get/set/update).
    // Sin esta regla, cualquier creación de transacción con voucher fallaba (default deny).
    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    // Configuración de la Aplicación y Estadísticas Globales
    match /appConfig/{document=**} {
      // Todos los usuarios autenticados pueden leer la configuración.
      allow read: if request.auth != null;
      // Solo el administrador puede modificar la configuración o estadísticas.
      allow write: if isAdmin();
    }
  }
}
